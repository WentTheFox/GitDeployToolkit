#!/usr/bin/env bash
# Set up a new app for push-to-deploy on this server:
#   - creates the bare repo
#   - creates the worktree directory
#   - writes deploy.env (server-side, just says where to check out)
#   - symlinks hooks/post-receive to the shared toolkit hook
#
# Usage: git-deploy-new <app-name> [worktree-path] [branch]

set -euo pipefail

TOOLKIT_LIB="${GIT_DEPLOY_LIB:-/usr/local/lib/git-deploy}"
REPO_ROOT="${GIT_DEPLOY_REPO_ROOT:-/srv/git}"
ETC_DIR="${GIT_DEPLOY_ETC:-/etc/git-deploy}"

# The server's dedicated deploy user (install.sh --deploy-user) owns everything
# and is who pushes; otherwise fall back to whoever ran sudo, as before.
OWNER=""
[[ -f "$ETC_DIR/user" ]] && OWNER="$(head -n1 "$ETC_DIR/user")"
[[ -n "$OWNER" ]] || OWNER="${SUDO_USER:-}"

APP_NAME="${1:?Usage: git-deploy-new <app-name> [worktree-path] [branch]}"
WORKTREE="${2:-/var/www/$APP_NAME}"
BRANCH="${3:-main}"

BARE_REPO="$REPO_ROOT/$APP_NAME.git"

if [[ -e "$BARE_REPO" ]]; then
  echo "git-deploy-new: $BARE_REPO already exists, aborting" >&2
  exit 1
fi

if [[ ! -f "$TOOLKIT_LIB/post-receive" ]]; then
  echo "git-deploy-new: $TOOLKIT_LIB/post-receive not found — run install.sh first" >&2
  exit 1
fi

WORKTREE_EXISTED=0
[[ -e "$WORKTREE" ]] && WORKTREE_EXISTED=1

mkdir -p "$REPO_ROOT" "$WORKTREE"
git init --quiet --bare "$BARE_REPO"

# 600: it may later hold a secret (DISCORD_WEBHOOK_URL). Only the deploy
# user needs to read it.
install -m 600 /dev/null "$BARE_REPO/deploy.env"
cat > "$BARE_REPO/deploy.env" <<EOF
WORKTREE=$WORKTREE
BRANCH=$BRANCH
EOF

ln -sf "$TOOLKIT_LIB/post-receive" "$BARE_REPO/hooks/post-receive"
# Refuses pushes from anyone but the deploy user (a no-op until one is set).
[[ -f "$TOOLKIT_LIB/pre-receive" ]] && ln -sf "$TOOLKIT_LIB/pre-receive" "$BARE_REPO/hooks/pre-receive"
chmod +x "$TOOLKIT_LIB/post-receive"

# This is typically run via sudo (it writes under /srv and /usr/local),
# which would otherwise leave the bare repo root-owned. Deploys then run
# as whoever pushes to it — if that's root, `git checkout -f` writes
# root-owned files into what should be the app's own worktree, and any
# `pm2 restart` in deploy_restart targets root's pm2 daemon instead of
# the one actually running the app, so the restart silently no-ops.
# Chown to $OWNER (the deploy user, or the person who ran sudo) so pushes/deploys happen
# as the actual app owner instead.
# An already-existing worktree (migrating a live app) is left alone: it
# can hold deliberately www-data-owned/grouped dirs (storage/, uploads)
# that a recursive chown would take away from the web server.
if [[ -n "$OWNER" && "$OWNER" != "root" ]]; then
  chown -R "$OWNER:$(id -gn "$OWNER")" "$BARE_REPO"
  echo "git-deploy-new: chowned $BARE_REPO to $OWNER"
  if [[ "$WORKTREE_EXISTED" == 0 ]]; then
    chown "$OWNER:$(id -gn "$OWNER")" "$WORKTREE"
    echo "git-deploy-new: chowned new worktree $WORKTREE to $OWNER"
  else
    echo "git-deploy-new: $WORKTREE already existed, left its ownership alone"
  fi
fi

echo "git-deploy-new: created $BARE_REPO"
echo "git-deploy-new: worktree -> $WORKTREE (branch: $BRANCH)"
echo
echo "On your dev machine:"
echo "  git remote add deploy ssh://${OWNER:-$(whoami)}@$(hostname -f 2>/dev/null || hostname)$BARE_REPO"
echo "  git push deploy $BRANCH"
echo
echo "In the app's repo, copy template/deploy.conf.example to deploy.conf,"
echo "fill in deploy_build/deploy_restart, and commit it."
