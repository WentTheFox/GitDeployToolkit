#!/usr/bin/env bash
# Generic post-receive hook, shared by every app on this server.
# Installed once by install.sh and symlinked from each bare repo's
# hooks/post-receive by `git-deploy-new`. Never edit a per-app copy —
# edit this file (or update the toolkit) and every app picks it up.
#
# Per-app behavior comes from two files, read at deploy time:
#   $GIT_DIR/deploy.env   (server-side, created by git-deploy-new)
#     WORKTREE=/var/www/myapp
#     BRANCH=main                # optional, defaults to main
#     RELEASES=1                 # optional: release directories + atomic
#                                # symlink swap, see docs/releases.md
#   $WORKTREE/deploy.conf        (in the app's own repo, versioned there)
#     deploy_build()   { ... }   # optional
#     deploy_restart() { ... }   # optional
#
# Every deploy also appends JSON-lines to $GIT_DIR/deploy.jsonl (server-side,
# never tracked — GIT_DIR here is the bare repo, so this is the toolkit's
# equivalent of a worktree's .git/deploy.jsonl). One "start" line and one
# "complete" line per push, so an agent can grep the last line for when the
# app was last deployed and whether it succeeded.

set -euo pipefail

GIT_DIR=$(git rev-parse --git-dir)
GIT_DIR=$(cd "$GIT_DIR" && pwd)
ENV_FILE="$GIT_DIR/deploy.env"
DEPLOY_LOG="$GIT_DIR/deploy.jsonl"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "git-deploy: missing $ENV_FILE — run git-deploy-new to set this app up" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$ENV_FILE"
: "${WORKTREE:?WORKTREE not set in $ENV_FILE}"
: "${BRANCH:=main}"

# $1 = event (start|complete), $2 = extra JSON fields (leading comma, or "")
log_deploy_event() {
  printf '{"event":"%s","time":"%s","branch":"%s","commit":"%s","prev_commit":"%s"%s}\n' \
    "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$BRANCH" "$newrev" "$oldrev" "$2" \
    >> "$DEPLOY_LOG"
}

# Discord messages when a deploy starts and ends, if deploy.env has
# DISCORD_WEBHOOK_URL (see git-deploy-notify). Best-effort, never fails the
# deploy. Sent from here, the one place every deploy passes exactly once:
# a push that hands off to git-deploy-webhook below comes back through
# here with GIT_DEPLOY_NO_GITHUB set, and that's the run that notifies.
NOTIFY="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/git-deploy-notify"
notify() { # notify <started|success|failed> [duration-s]
  [[ -n "${DISCORD_WEBHOOK_URL:-}" && -x "$NOTIFY" ]] || return 0
  "$NOTIFY" "$1" "$GIT_DIR" "$oldrev" "$newrev" "${2:-}" || true
}
# Something aborting the hook between the two (a failed checkout) must not
# leave the channel thinking the deploy is still running.
NOTIFY_PENDING=""
trap '[[ -z "$NOTIFY_PENDING" ]] || notify failed "$(( $(date +%s) - DEPLOY_START_EPOCH ))"' EXIT

# --- release directories (RELEASES=1) -------------------------------------

link_shared() { # link_shared <path relative to the release>
  local p="$1"
  if [[ "$p" == /* || "/$p/" == *"/../"* || -z "$p" ]]; then
    echo "git-deploy: SHARED entry '$p' must be a relative path without .." >&2
    return 1
  fi
  if [[ ! -e "$SHARED_DIR/$p" && ! -L "$SHARED_DIR/$p" ]]; then
    echo "git-deploy: shared/$p is missing — create it or run git-deploy-releases-init" >&2
    return 1
  fi
  rm -rf "${RELEASE:?}/$p"
  mkdir -p "$(dirname "$RELEASE/$p")"
  ln -s "$SHARED_DIR/$p" "$RELEASE/$p"
}

# Point $WORKTREE at the new release. rename(2) of a fresh symlink over the
# old one is atomic: a request sees the old release or the new, never a mix.
swap_release() {
  local tmp="$WORKTREE.new.$$"
  ln -s "$RELEASE" "$tmp"
  mv -T "$tmp" "$WORKTREE"
  echo "git-deploy: $WORKTREE now serves release $RELEASE_ID (was ${PREV_RELEASE:-nothing})"
}

# Keep the newest KEEP_RELEASES (at least 2), and never the live release or
# the one before it, which is what git-deploy-rollback goes back to. Failing
# to delete one is not a failed deploy.
prune_releases() {
  local live n=0 r
  live=$(basename "$(readlink "$WORKTREE")")
  while read -r r; do
    n=$((n + 1))
    (( n > ${KEEP_RELEASES} && n > 2 )) || continue
    [[ "$r" != "$live" && "$r" != "$PREV_RELEASE" ]] || continue
    rm -rf "${RELEASES_DIR:?}/releases/$r" && echo "git-deploy: pruned release $r" \
      || echo "git-deploy: could not prune release $r — continuing" >&2
  done < <(ls -1 "$RELEASES_DIR/releases" | sort -r)
}

while read -r oldrev newrev ref; do
  if [[ "$ref" != "refs/heads/$BRANCH" ]]; then
    echo "git-deploy: ignoring push to $ref (this app deploys $BRANCH only)" >&2
    continue
  fi

  if [[ "$newrev" == "0000000000000000000000000000000000000000" ]]; then
    echo "git-deploy: branch $BRANCH deleted, not touching $WORKTREE" >&2
    continue
  fi

  # An app opted in to GitHub Deployments (GITHUB_REPO in deploy.env) gets
  # manual pushes recorded there too: git-deploy-webhook's push mode creates
  # the Deployment, then runs this same hook again for the actual deploy
  # with GIT_DEPLOY_NO_GITHUB set (as webhook mode does), so this only
  # hands off once. It lives next to this hook's real (symlinked) path.
  HANDOFF="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/git-deploy-webhook"
  if [[ -z "${GIT_DEPLOY_NO_GITHUB:-}" && -n "${GITHUB_REPO:-}" && -x "$HANDOFF" ]]; then
    "$HANDOFF" --push "$GIT_DIR" "$oldrev" "$newrev" || exit 1
    continue
  fi

  DEPLOY_START_EPOCH=$(date +%s)
  log_deploy_event "start" ""
  notify started
  NOTIFY_PENDING=1

  # CODE is where this deploy's files are checked out and where deploy.conf
  # is read from; RELEASE is what deploy_build builds. In-place they are both
  # $WORKTREE. With RELEASES=1 (docs/releases.md) $WORKTREE is a symlink to
  # the live release, a deploy builds a fresh one next to it, and the symlink
  # only moves once deploy_build succeeded, so a failed build never touches
  # what is being served.
  RELEASE_JSON=""
  if [[ -n "${RELEASES:-}" ]]; then
    RELEASES_DIR="${RELEASES_DIR:-$WORKTREE.d}"
    KEEP_RELEASES="${KEEP_RELEASES:-5}"
    SHARED_DIR="$RELEASES_DIR/shared"
    RELEASE_ID="$(date -u +%Y%m%d%H%M%S.%3N)-${newrev:0:12}"
    RELEASE="$RELEASES_DIR/releases/$RELEASE_ID"
    PREV_RELEASE=""
    if [[ -L "$WORKTREE" ]]; then
      PREV_RELEASE=$(basename "$(readlink "$WORKTREE")")
    elif [[ -e "$WORKTREE" ]]; then
      # A brand-new app has the empty directory git-deploy-new made; an app
      # with real content needs git-deploy-releases-init (it can't be swapped
      # for a symlink atomically, so it is a deliberate one-time step).
      rmdir "$WORKTREE" 2> /dev/null || {
        echo "git-deploy: RELEASES=1 but $WORKTREE is a real directory with content — run git-deploy-releases-init $(basename "$GIT_DIR" .git) once (docs/releases.md)" >&2
        exit 1
      }
    fi
    CODE="$RELEASE"
    RELEASE_JSON=",\"release\":\"$RELEASE_ID\""
    mkdir -p "$RELEASES_DIR/releases" "$SHARED_DIR"
    mkdir "$RELEASE"
    echo "git-deploy: checking out $BRANCH ($newrev) into release $RELEASE_ID"
    # A throwaway index, so the bare repo's own HEAD and index stay put.
    GIT_INDEX_FILE="$RELEASES_DIR/.index.$$" git --git-dir="$GIT_DIR" --work-tree="$RELEASE" read-tree "$newrev"
    GIT_INDEX_FILE="$RELEASES_DIR/.index.$$" git --git-dir="$GIT_DIR" --work-tree="$RELEASE" checkout-index -a -f
    rm -f "$RELEASES_DIR/.index.$$"
  else
    CODE="$WORKTREE"
    RELEASE="$WORKTREE"
    mkdir -p "$WORKTREE"
    echo "git-deploy: checking out $BRANCH ($newrev) into $WORKTREE"
    git --work-tree="$WORKTREE" --git-dir="$GIT_DIR" checkout -f "$BRANCH"
  fi

  # The worktree has no .git of its own, so anything in the app that asks
  # git "what's deployed?" has no answer. Leave one: sha on line 1, committer
  # date (ISO 8601) on line 2. Untracked, so checkout -f never touches it.
  # A .git *directory* here is a pre-toolkit relic that answers with a stale
  # commit instead — see README "Leftover .git in the worktree".
  git --git-dir="$GIT_DIR" log -1 --format='%H%n%cI' "$newrev" > "$CODE/.git-deploy-commit" \
    || echo "git-deploy: could not write $CODE/.git-deploy-commit" >&2
  if [[ -d "$CODE/.git" ]]; then
    echo "git-deploy: warning: $CODE/.git is a real repository left from before the toolkit; it reports a stale commit. Back it up and remove it (README: Leftover .git in the worktree)" >&2
  fi

  # Opt-in log retention policy: an app that commits deploy.logrotate gets it
  # validated and installed into /etc/logrotate.d by a root helper (never
  # run — the system's logrotate timer rotates). Best effort by design: a
  # missing sudo rule or a refused file warns and is recorded in
  # deploy.jsonl, but never fails the deploy. Every deploy states each log's
  # retention (needs no root, so it is reported even when the install isn't
  # possible), and those lines are part of the public summary log. See
  # docs/logrotate.md.
  LOGROTATE_STATUS="absent"
  LOGROTATE_RETENTION="[]"
  LOGROTATE_HELPER="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/git-deploy-logrotate"
  LOGROTATE_APP=$(basename "$GIT_DIR" .git)
  if [[ -f "$CODE/deploy.logrotate" && ! -L "$CODE/deploy.logrotate" ]]; then
    if [[ ! -x "$LOGROTATE_HELPER" ]]; then
      LOGROTATE_STATUS="unavailable"
      echo "git-deploy: logrotate: helper not installed, retention not checked — continuing" >&2
    elif ! LOGROTATE_RETENTION=$("$LOGROTATE_HELPER" report "$LOGROTATE_APP" "$WORKTREE" < "$CODE/deploy.logrotate"); then
      LOGROTATE_STATUS="refused"
      LOGROTATE_RETENTION="[]"
      echo "git-deploy: logrotate: deploy.logrotate not installed (refused) — continuing" >&2
    else
      # GIT_DEPLOY_LOGROTATE_SUDO="" lets the tests (and a root deploy user) skip sudo.
      # shellcheck disable=SC2086
      if LOGROTATE_STATUS=$(${GIT_DEPLOY_LOGROTATE_SUDO-sudo -n} "$LOGROTATE_HELPER" install "$LOGROTATE_APP" "$WORKTREE" < "$CODE/deploy.logrotate"); then
        echo "git-deploy: logrotate: policy $LOGROTATE_STATUS"
      else
        [[ "$LOGROTATE_STATUS" == refused ]] || LOGROTATE_STATUS="unavailable"
        echo "git-deploy: logrotate: deploy.logrotate not installed ($LOGROTATE_STATUS) — continuing" >&2
      fi
    fi
  else
    echo "git-deploy: logrotate: no deploy.logrotate, log retention is not managed by this repo"
  fi

  # Opt-in scheduled jobs: an app that commits deploy.cron gets it validated
  # and installed as /etc/cron.d/git-deploy-<app> by a root helper (a job
  # never runs as root, and never while the same worktree is scheduled
  # elsewhere). Same contract as deploy.logrotate above: best effort, never
  # fails the deploy, every deploy states what is scheduled (and the lines
  # are part of the public summary log), the outcome goes to deploy.jsonl.
  # See docs/cron.md.
  CRON_STATUS="absent"
  CRON_JOBS="[]"
  CRON_HELPER="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/git-deploy-cron"
  CRON_INSTALLED="${CRON_D:-/etc/cron.d}/git-deploy-$LOGROTATE_APP"
  if [[ -f "$CODE/deploy.cron" && ! -L "$CODE/deploy.cron" ]]; then
    if [[ ! -x "$CRON_HELPER" ]]; then
      CRON_STATUS="unavailable"
      echo "git-deploy: cron: helper not installed, deploy.cron not checked — continuing" >&2
    elif ! CRON_JOBS=$("$CRON_HELPER" report "$LOGROTATE_APP" "$WORKTREE" < "$CODE/deploy.cron"); then
      CRON_STATUS="refused"
      CRON_JOBS="[]"
      echo "git-deploy: cron: deploy.cron not installed (refused) — continuing" >&2
    else
      # GIT_DEPLOY_CRON_SUDO="" lets the tests (and a root deploy user) skip sudo.
      # shellcheck disable=SC2086
      if CRON_STATUS=$(${GIT_DEPLOY_CRON_SUDO-sudo -n} "$CRON_HELPER" install "$LOGROTATE_APP" "$WORKTREE" < "$CODE/deploy.cron"); then
        echo "git-deploy: cron: schedule $CRON_STATUS"
      else
        [[ "$CRON_STATUS" == refused ]] || CRON_STATUS="unavailable"
        echo "git-deploy: cron: deploy.cron not installed ($CRON_STATUS) — continuing" >&2
      fi
    fi
  elif [[ -e "$CRON_INSTALLED" ]]; then
    CRON_STATUS="stale"
    echo "git-deploy: cron: $CRON_INSTALLED is still installed but this repo has no deploy.cron any more — its jobs keep running until removed (git-deploy-cron remove $LOGROTATE_APP)" >&2
  else
    echo "git-deploy: cron: no deploy.cron, scheduled jobs are not managed by this repo"
  fi

  DEPLOY_STATUS="success"
  APP_CONF="$CODE/deploy.conf"
  if [[ -f "$APP_CONF" || -n "${RELEASES:-}" ]]; then
    # Run in a subshell so deploy_build/deploy_restart from a previous
    # iteration (unlikely, but defensive) can't leak, and so `cd` here
    # never affects the rest of the hook. Errors are captured (rather than
    # left to `set -e` kill the hook outright) so a "complete" line with
    # status=failed always gets logged before we exit non-zero.
    set +e
    (
      set -e
      cd "$CODE"
      # Name the command that failed before set -e aborts, so a failed
      # deploy says more than "hook exited 1". $BASH_COMMAND is the
      # unexpanded source text (same as what's committed in deploy.conf),
      # so no variable values end up in the log. git-deploy-webhook relies
      # on this line to report failures without publishing full output.
      # -E so it fires inside deploy_build/deploy_restart too; the subshell
      # level check skips failures inside a $(...) that the caller
      # tolerates (it still fires for the command that actually aborts).
      set -E
      _git_deploy_level=$BASH_SUBSHELL
      trap '_git_deploy_rc=$?; if [[ $BASH_SUBSHELL == "$_git_deploy_level" ]]; then echo "git-deploy: failed (exit $_git_deploy_rc) in ${FUNCNAME[0]:-deploy.conf}: $BASH_COMMAND" >&2; fi' ERR
      if [[ -f "$APP_CONF" ]]; then
        # shellcheck source=/dev/null
        source "$APP_CONF"
      else
        echo "git-deploy: no deploy.conf in repo root, skipping build/restart"
      fi

      if [[ -n "${RELEASES:-}" ]]; then
        # deploy.conf's SHARED=(.env storage ...): paths that outlive a
        # release. Each is replaced in the new release by a link into
        # $SHARED_DIR (created by git-deploy-releases-init, or by hand).
        for _shared in ${SHARED[@]+"${SHARED[@]}"}; do
          link_shared "$_shared"
        done
      fi

      if declare -f deploy_build > /dev/null; then
        echo "git-deploy: running deploy_build"
        deploy_build
      fi

      if [[ -n "${RELEASES:-}" ]]; then
        swap_release
      fi

      if declare -f deploy_restart > /dev/null; then
        echo "git-deploy: running deploy_restart"
        deploy_restart
      fi

      if [[ -n "${RELEASES:-}" ]]; then
        prune_releases
      fi
    )
    if [[ $? -ne 0 ]]; then
      DEPLOY_STATUS="failed"
      # Died before the swap: the new release was never served, so it is of
      # no use to anyone. (After the swap it is live and stays.)
      if [[ -n "${RELEASES:-}" && "$(readlink "$WORKTREE" 2> /dev/null || true)" != "$RELEASE" ]]; then
        rm -rf "$RELEASE" || true
        echo "git-deploy: new release discarded, $WORKTREE still serves ${PREV_RELEASE:-nothing}" >&2
      fi
    fi
    set -e
  else
    echo "git-deploy: no deploy.conf in repo root, skipping build/restart"
  fi

  DEPLOY_DURATION=$(( $(date +%s) - DEPLOY_START_EPOCH ))
  log_deploy_event "complete" ",\"status\":\"$DEPLOY_STATUS\",\"duration_s\":$DEPLOY_DURATION,\"logrotate\":\"$LOGROTATE_STATUS\",\"retention\":$LOGROTATE_RETENTION,\"cron\":\"$CRON_STATUS\",\"cron_jobs\":$CRON_JOBS$RELEASE_JSON"
  NOTIFY_PENDING=""
  notify "$DEPLOY_STATUS" "$DEPLOY_DURATION"

  if [[ "$DEPLOY_STATUS" == "failed" ]]; then
    echo "git-deploy: deploy_build/deploy_restart failed for $WORKTREE — see $DEPLOY_LOG" >&2
    exit 1
  fi

  echo "git-deploy: deployed $newrev to $WORKTREE"
done
