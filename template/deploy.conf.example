# Copy this file to deploy.conf at the ROOT of your app's repo and commit
# it. It's sourced (as bash) by the shared post-receive hook, with cwd set
# to the freshly checked-out worktree, right after every push to the
# deploy branch (default: main).
#
# Both functions are optional — define whichever your app needs.
# Untracked files (.env, node_modules, vendor, storage/, etc.) are left
# alone by the checkout, so it's safe to keep persistent per-server state
# there — just make sure it's gitignored.
#
# Both functions also see $WORKTREE, $BRANCH, $GIT_DIR, and the commit
# range just pushed ($oldrev/$newrev — $oldrev is all-zeros on the first
# push), so deploy_restart can make a restart decision based on what
# changed, e.g. `git --git-dir="$GIT_DIR" diff --name-only "$oldrev"
# "$newrev"`. See deploy.conf.graceful-respawn.example for a long-lived
# process (e.g. a discord.js ShardingManager) that only needs a full
# restart when its own entry-point code changes, and can otherwise
# signal itself to reload gracefully.

# --- PHP-FPM example -------------------------------------------------
deploy_build() {
  composer install --no-dev --optimize-autoloader --no-interaction
}

deploy_restart() {
  sudo systemctl restart php-fpm-myapp
}

# --- Node / pm2 example -----------------------------------------------
# deploy_build() {
#   npm ci
#   npm run build
# }
#
# deploy_restart() {
#   pm2 reload myapp
# }

# --- Several deploy targets sharing this file -------------------------
# If more than one bare repo deploys this same deploy.conf (e.g. prod +
# a beta copy), decide dangerous per-target steps like DB migrations
# HERE, keyed on $GIT_DIR, and fail closed: only an explicitly listed
# target runs them. Don't make "run it" the default and rely on an
# untracked per-worktree file to turn it off — if that file is ever lost
# or re-created without the flag, the default silently flips back on.
#
# deploy_build() {
#   case "$(basename "$GIT_DIR")" in
#     myapp.git) php artisan migrate --force ;;
#     *) echo "git-deploy: not migrating $(basename "$GIT_DIR") (not in deploy.conf's migrate allowlist)" ;;
#   esac
# }

# Notes on sudo:
# deploy_restart commands that need root (systemctl, etc.) require the
# deploy user to have passwordless sudo for exactly that command. See
# README.md for a sudoers snippet that scopes this narrowly.
