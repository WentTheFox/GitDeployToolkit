# Copy this file to .github/workflows/deploy.yml in your app's own repo
# (GitHub only ever looks for workflows inside the repo they belong to,
# so unlike deploy.conf this can't live centrally — this template is the
# shared source, copied per app same as deploy.conf.example).
#
# Gives you a button-triggered "deploy" in GitHub's Actions tab that does
# exactly what you'd otherwise type by hand — `git push deploy main` —
# from a self-hosted runner living on the same server `deploy` pushes to.
# No new deploy logic and no third-party CI/deploy subscription: the
# runner just hands off to this app's own deploy.conf via the same
# post-receive hook every ordinary push already goes through. See
# README.md's "Triggering deploys from GitHub Actions" section for the
# one-time runner setup this depends on.
#
# workflow_dispatch only, never on push — deploying briefly takes the
# app down during deploy_build/deploy_restart, so it should always be a
# deliberate, in-the-moment decision, never automatic off a merge.
#
# SECURITY: if this app's repo is public, NEVER add a `pull_request` (or
# `pull_request_target`, or `push` from an untrusted branch) trigger to
# ANY workflow that targets the "git-deploy" runner label, and never
# change this workflow's own `on:` to include one. That's the textbook
# self-hosted-runner-on-a-public-repo hole: a stranger's fork/PR could
# then run arbitrary code on your real server. workflow_dispatch is safe
# here specifically because triggering it requires repo *write* access —
# keep it that way.

name: Deploy

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: 'Type "deploy" to confirm.'
        required: true

# Only one deploy of THIS app at a time — a second click while one is
# still running waits for it rather than racing it (git-deploy-toolkit's
# own checkout-in-place has no protection against two concurrent pushes
# either, so this is the workflow's job to prevent).
concurrency:
  group: deploy
  cancel-in-progress: false

jobs:
  deploy:
    # git-deploy toolkit convention: ONE runner per server, registered
    # with the "git-deploy" label (not one runner per app) — every app on
    # that server targets the same label, same as they all share one
    # post-receive hook. See README.md before registering a second runner
    # with this label on a different server thinking it's required per-app.
    runs-on: [self-hosted, git-deploy]
    # Optional extra gate on top of the confirm input above: create a
    # "production" environment (Settings -> Environments) and add
    # required reviewers there to require an approval, from someone other
    # than whoever clicked "Run workflow", before this job actually runs
    # on the runner. A no-op until you configure reviewers — GitHub
    # auto-creates an unprotected environment the first time this runs if
    # one doesn't exist yet.
    environment: production
    steps:
      - name: Confirm
        run: |
          if [ "${{ github.event.inputs.confirm }}" != "deploy" ]; then
            echo 'Confirmation text didn'"'"'t match "deploy" — aborting.' >&2
            exit 1
          fi

      - uses: actions/checkout@v4

      # Change HEAD:main if this app's deploy.env uses a non-default
      # BRANCH — see the git-deploy-new output/README for what this app
      # was set up with.
      - name: Push to the deploy remote
        run: git push "${{ secrets.DEPLOY_REMOTE_URL }}" HEAD:main
