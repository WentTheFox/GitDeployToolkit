# /etc/git-deploy/webhook.env — config for git-deploy-webhook@<user>.service.
# Server-side only, holds secrets: chown root:<deploy-user>, chmod 640.

# Shared secret for GitHub's webhook HMAC signature. Paste the same value
# into each app repo's webhook (Settings -> Webhooks -> Secret). Generate
# with: openssl rand -hex 32
GIT_DEPLOY_WEBHOOK_SECRET=

# Local port the listener binds on 127.0.0.1 (nginx proxies to it).
GIT_DEPLOY_WEBHOOK_PORT=9321

# Fine-grained GitHub token, used ONLY to post deployment statuses back
# (Repository access: just the apps deployed from this server;
# Permissions: Deployments = Read and write, nothing else). Without it
# deploys still happen, but GitHub never learns whether they worked and
# the Deploy workflow gives up after a minute.
GIT_DEPLOY_GITHUB_TOKEN=
# A fine-grained token only covers one owner (your user OR one org). For
# repos of another owner, add a token for it named after that owner,
# uppercased with - and . as _; it takes precedence for that owner's repos:
#GIT_DEPLOY_GITHUB_TOKEN_SOME_ORG=

# Per-deploy logs, served by nginx and tailed into the Actions run.
# The directory must be writable by the deploy user and readable by nginx.
GIT_DEPLOY_LOG_DIR=/var/lib/git-deploy/logs
GIT_DEPLOY_LOG_BASE_URL=https://webhook.example.com/logs
#GIT_DEPLOY_LOG_KEEP_DAYS=30

#GIT_DEPLOY_REPO_ROOT=/srv/git
